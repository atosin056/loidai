# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# coverage and caches
coverage/
.cache/
.turbo/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Android build output and local configuration
**/android/.gradle/
**/android/local.properties
**/android/**/build/
**/android/.cxx/
**/android/.externalNativeBuild/
**/android/captures/
**/android/*.iml

# iOS build output and local Xcode state
**/ios/Pods/
**/ios/build/
**/ios/DerivedData/
**/ios/xcuserdata/
**/ios/*.xcuserstate

# Metro
.metro-health-check*

# macOS
.DS_Store
*.pem

# Windows
Thumbs.db
Desktop.ini

# Editors
.idea/
*.swp
*.swo

# local environment files (keep example templates)
.env
.env.*
!.env.example
!.env.*.example

# typescript
*.tsbuildinfo

